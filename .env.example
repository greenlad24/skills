# Copy to .env for local development with `netlify dev`.
# In production these are set as Netlify environment variables, not committed.

# Password for the /admin editor. Required.
ADMIN_PASSWORD=

# Key used to sign admin session cookies. Optional but recommended:
# without it, a key is derived from ADMIN_PASSWORD.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Enables reading event details off uploaded posters in /admin.
# Groq's vision models are free at the volume this site posts at.
# Without it, posters still upload — you just fill the fields in yourself.
# Get one at console.groq.com/keys.
GROQ_API_KEY=

# Optional. Pins a specific Groq model. Leave blank to use the first vision
# model the account can reach, so a retired preview model is not an outage.
GROQ_MODEL=

