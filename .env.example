# AutoUGC-TH — environment contract (the single approved workflow).
# Copy to `.env` and fill in secrets: `cp .env.example .env`
# `.env` is git-ignored; this file is the documented contract (never put real secrets here).
#
# You normally do NOT edit the provider secrets by hand — the in-app onboarding
# wizard (http://localhost:8000 on first run) writes them here for you.

# =========================================================================
# Core infrastructure
# =========================================================================
POSTGRES_DB=autougc
POSTGRES_USER=autougc
POSTGRES_PASSWORD=change-me
# App DB URL. Uses psycopg2 driver. Inside Docker the host is `postgres`.
DATABASE_URL=postgresql+psycopg2://autougc:change-me@postgres:5432/autougc
# Leave DATABASE_URL empty to fall back to a local SQLite file (tests / no-Docker dev).

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Media storage (local volume by default).
MEDIA_ROOT=/data/media

# =========================================================================
# Provider selection — the single approved stack (do not change)
# =========================================================================
LLM_PROVIDER=anthropic
SCRAPER_PROVIDER=firecrawl
TTS_PROVIDER=google_tts
VIDEOGEN_PROVIDER=ltx_modal
POSTING_PROVIDER=tiktok

# =========================================================================
# 1) LLM — Anthropic (product/market research + Thai scripting)
# =========================================================================
ANTHROPIC_API_KEY=

# =========================================================================
# 2) Research scraping — Firecrawl (or Apify). Free tiers cover this volume.
# =========================================================================
FIRECRAWL_API_KEY=
APIFY_API_KEY=

# =========================================================================
# 3) Video — LTX-2.5 on Modal (serverless, no GPU to babysit, ~$0/mo)
# Deploy deploy/modal_ltx.py once (`modal deploy deploy/modal_ltx.py`), then
# paste the URL it prints. Scales to zero between renders; ~360 clips/mo sits
# inside Modal's $30/month free credit. See docs/free-video-ltx-modal.md.
# =========================================================================
MODAL_LTX_URL=
# Shared secret; must equal AUTOUGC_LTX_TOKEN in your Modal secret.
MODAL_LTX_TOKEN=
LTX_FPS=24
# $/GPU-second, used only to record an honest per-clip cost (default ~A10G rate).
MODAL_GPU_USD_PER_SEC=0.000306
MODAL_LTX_TIMEOUT_SECONDS=300

# =========================================================================
# 4) Thai voiceover — Google Cloud Text-to-Speech (free tier => ~$0)
# =========================================================================
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=th-TH-Neural2-C
GOOGLE_TTS_LANGUAGE=th-TH
GOOGLE_TTS_USD_PER_MILLION=0.0
GOOGLE_TTS_SEC_PER_CHAR=0.08

# =========================================================================
# 5) Posting — TikTok official Content Posting API (no per-post fee)
#   TIKTOK_POSTING_MODE=direct  -> publish to profile (audited app, video.publish)
#   TIKTOK_POSTING_MODE=inbox   -> upload to drafts, you tap post (unaudited, video.upload)
# ai_disclosure from the pipeline sets the post's is_aigc label automatically.
# =========================================================================
TIKTOK_ACCESS_TOKEN=
TIKTOK_API_BASE=https://open.tiktokapis.com
TIKTOK_POSTING_MODE=direct
TIKTOK_PRIVACY_LEVEL=

# =========================================================================
# Guards & run mode
# =========================================================================
# DRY_RUN=true routes EVERY provider through a deterministic Fake ($0 spend, no network).
# The onboarding wizard flips this to false when setup is complete.
DRY_RUN=true
# Set true by the onboarding wizard when first-run setup is finished.
ONBOARDED=false
# Per-video cost ceiling; a projected breach fails the job (failure_reason=budget_exceeded).
PER_VIDEO_COST_BUDGET_USD=5.00

# Optional single local password (X-App-Password header). Unset = open on localhost.
APP_PASSWORD=
