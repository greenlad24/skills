# AutoUGC-TH — environment contract.
# Copy to `.env` and fill in secrets: `cp .env.example .env`
# `.env` is git-ignored; this file is the documented contract (never put real secrets here).

# =========================================================================
# Core infrastructure
# =========================================================================
POSTGRES_DB=autougc
POSTGRES_USER=autougc
POSTGRES_PASSWORD=change-me
# App DB URL. Uses psycopg2 driver. Inside Docker the host is `postgres`.
DATABASE_URL=postgresql+psycopg2://autougc:change-me@postgres:5432/autougc
# Leave DATABASE_URL empty to fall back to a local SQLite file (tests / no-Docker dev).

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Media storage (local volume by default; MinIO/S3 optional).
MEDIA_ROOT=/data/media
MEDIA_BUCKET=autougc-media
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me

# =========================================================================
# Provider selection (swap vendor without touching code — see adapters/registry.py)
# =========================================================================
LLM_PROVIDER=anthropic
SCRAPER_PROVIDER=apify
AVATAR_PROVIDER=heygen
TTS_PROVIDER=elevenlabs
VIDEOGEN_PROVIDER=fal
POSTING_PROVIDER=postpeer

# =========================================================================
# External provider API keys (secrets — leave blank here, fill in .env)
# =========================================================================
ANTHROPIC_API_KEY=
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=
FAL_API_KEY=
APIFY_API_KEY=
FIRECRAWL_API_KEY=
RAINFOREST_API_KEY=
POSTPEER_API_KEY=

# =========================================================================
# Reused-forever identities (created once in the setup wizard)
# =========================================================================
HEYGEN_AVATAR_ID=
ELEVENLABS_VOICE_ID=

# =========================================================================
# FREE video generation — Wan via self-hosted ComfyUI (open-source, ~$0)
# Set VIDEOGEN_PROVIDER=wan_comfyui above, then point COMFYUI_URL at a ComfyUI
# server: a free Kaggle/Colab GPU (notebooks/wan_comfyui_kaggle.ipynb) or a
# cheap rented GPU. Generation then costs $0 (your GPU) instead of paying Seedance.
# =========================================================================
COMFYUI_URL=
# Optional: your own exported ComfyUI "API format" workflow with placeholder tokens.
# Empty => the bundled sample template (app/core/adapters/real/workflows/wan_i2v_template.json).
COMFYUI_WORKFLOW_PATH=
COMFYUI_FPS=16

# =========================================================================
# CHEAP serverless video — LTX-2.5 on Modal (no GPU to babysit, ~$0/mo)
# Set VIDEOGEN_PROVIDER=ltx_modal above. Deploy deploy/modal_ltx.py once
# (`modal deploy deploy/modal_ltx.py`), then paste the URL it prints here.
# Scales to zero between renders; ~360 clips/mo of compute sits inside
# Modal's $30/month free credit => effectively $0. See docs/free-video-ltx-modal.md.
# =========================================================================
MODAL_LTX_URL=
# Shared secret; must equal AUTOUGC_LTX_TOKEN in your Modal secret (`modal secret create`).
MODAL_LTX_TOKEN=
LTX_FPS=24
# $/GPU-second, used only to record an honest per-clip cost in the ledger
# (default ~A10G list rate). Set 0 to report generation as free.
MODAL_GPU_USD_PER_SEC=0.000306
MODAL_LTX_TIMEOUT_SECONDS=300

# =========================================================================
# Guards & run mode
# =========================================================================
# DRY_RUN=true routes EVERY provider through a deterministic Fake ($0 spend, no network).
DRY_RUN=true
# Per-video cost ceiling; a projected breach fails the job (failure_reason=budget_exceeded).
PER_VIDEO_COST_BUDGET_USD=5.00

# Optional single local password (X-App-Password header). Unset = open on localhost.
APP_PASSWORD=
