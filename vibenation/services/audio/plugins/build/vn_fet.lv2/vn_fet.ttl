@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

<https://vibenation.app/lv2/vn_fet>
    a lv2:Plugin , lv2:CompressorPlugin ;
    doap:name "VN FET Compressor" ;
    doap:license <http://opensource.org/licenses/MIT> ;
    doap:maintainer [ foaf:name "VibeNation" ; foaf:homepage <https://vibenation.app/> ] ;
    rdfs:comment "1176-style FET compressor: input, output, ratio 4/8/12/20/all, attack 20-800 us, release 50-1100 ms, colour, mix. Outputs gain reduction in dB." ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:minorVersion 0 ;
    lv2:microVersion 1 ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "Input" 
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Output" 
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "attack" ;
        lv2:name "Attack" ;
        lv2:minimum 20.0 ;
        lv2:maximum 800.0 ;
        lv2:default 300.0 ;
        lv2:portProperty pprops:logarithmic
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "colour" ;
        lv2:name "Colour" ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        lv2:default 50.0 ;
        units:unit units:pc
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 4 ;
        lv2:symbol "gr" ;
        lv2:name "Gain Reduction" ;
        lv2:minimum 0.0 ;
        lv2:maximum 40.0 ;
        lv2:default 0.0 ;
        units:unit units:db
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "input" ;
        lv2:name "Input" ;
        lv2:minimum -20.0 ;
        lv2:maximum 40.0 ;
        lv2:default 0.0 ;
        units:unit units:db
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        lv2:default 100.0 ;
        units:unit units:pc
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "output" ;
        lv2:name "Output" ;
        lv2:minimum -30.0 ;
        lv2:maximum 20.0 ;
        lv2:default 0.0 ;
        units:unit units:db
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "ratio" ;
        lv2:name "Ratio" ;
        lv2:minimum 0.0 ;
        lv2:maximum 4.0 ;
        lv2:default 0.0 ;
        lv2:scalePoint [ rdfs:label "4:1" ; rdf:value 0.0 ] , [ rdfs:label "8:1" ; rdf:value 1.0 ] , [ rdfs:label "12:1" ; rdf:value 2.0 ] , [ rdfs:label "20:1" ; rdf:value 3.0 ] , [ rdfs:label "All" ; rdf:value 4.0 ] ;
        lv2:portProperty lv2:integer , lv2:enumeration
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "release" ;
        lv2:name "Release" ;
        lv2:minimum 50.0 ;
        lv2:maximum 1100.0 ;
        lv2:default 300.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:ms
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 10 ;
        lv2:symbol "latency" ;
        lv2:name "Latency" ;
        lv2:minimum 0.0 ;
        lv2:maximum 64.0 ;
        lv2:default 0.0 ;
        lv2:designation lv2:latency ;
        lv2:portProperty lv2:reportsLatency , lv2:integer ;
        units:unit units:frame
    ] .
