@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

<https://vibenation.app/lv2/vn_opto>
    a lv2:Plugin , lv2:CompressorPlugin ;
    doap:name "VN Opto Leveler" ;
    doap:license <http://opensource.org/licenses/MIT> ;
    doap:maintainer [ foaf:name "VibeNation" ; foaf:homepage <https://vibenation.app/> ] ;
    rdfs:comment "T4 optical leveler: Peak Reduction, Gain, Mix, 3-band sidechain emphasis. Outputs gain reduction in dB." ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:minorVersion 0 ;
    lv2:microVersion 1 ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "Input" 
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Output" 
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "colour" ;
        lv2:name "Tube Colour" ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        lv2:default 30.0 ;
        units:unit units:pc
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "gain" ;
        lv2:name "Gain" ;
        lv2:minimum -20.0 ;
        lv2:maximum 30.0 ;
        lv2:default 0.0 ;
        units:unit units:db
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 4 ;
        lv2:symbol "gr" ;
        lv2:name "Gain Reduction" ;
        lv2:minimum 0.0 ;
        lv2:maximum 40.0 ;
        lv2:default 0.0 ;
        units:unit units:db
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        lv2:default 100.0 ;
        units:unit units:pc
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "mode" ;
        lv2:name "Mode" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:default 0.0 ;
        lv2:scalePoint [ rdfs:label "Compress" ; rdf:value 0.0 ] , [ rdfs:label "Limit" ; rdf:value 1.0 ] ;
        lv2:portProperty lv2:integer , lv2:enumeration
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "peak_reduction" ;
        lv2:name "Peak Reduction" ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        lv2:default 30.0 ;
        units:unit units:pc
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "sc_high" ;
        lv2:name "Sidechain High 5 kHz" ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        lv2:default 0.0 ;
        units:unit units:db
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "sc_low" ;
        lv2:name "Sidechain Low 200 Hz" ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        lv2:default 0.0 ;
        units:unit units:db
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "sc_mid" ;
        lv2:name "Sidechain Mid 1.5 kHz" ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        lv2:default 0.0 ;
        units:unit units:db
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 11 ;
        lv2:symbol "latency" ;
        lv2:name "Latency" ;
        lv2:minimum 0.0 ;
        lv2:maximum 64.0 ;
        lv2:default 0.0 ;
        lv2:designation lv2:latency ;
        lv2:portProperty lv2:reportsLatency , lv2:integer ;
        units:unit units:frame
    ] .
