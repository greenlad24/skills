[Unit]
StartLimitIntervalSec=0
Description=VibeNation audio engine (mix, meters, listen stream)
After=vibenation-jack.service
Requires=vibenation-jack.service

[Service]
WorkingDirectory=/root/vibenation/vibenation/services/audio
ExecStart=/root/vibenation/vibenation/services/audio/.venv/bin/python -m vn_audio.server
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=LV2_PATH=/usr/local/lib/lv2:/usr/lib/lv2:/usr/lib/x86_64-linux-gnu/lv2
KillMode=control-group
LimitRTPRIO=95
LimitMEMLOCK=infinity
Environment=VN_STEMS=/root/vibenation-media/stems-2026-04-04

[Install]
WantedBy=multi-user.target
