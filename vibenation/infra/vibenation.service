[Unit]
StartLimitIntervalSec=0
Description=VibeNation web app
After=network.target

[Service]
User=vibe
Group=vibe
WorkingDirectory=/home/vibe/vibenation/vibenation/apps/server
ExecStart=/usr/bin/env pnpm start
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
