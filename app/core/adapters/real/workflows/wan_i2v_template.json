{
  "_README": "SAMPLE ComfyUI image-to-video workflow (API format) with placeholder tokens. Replace this file with your OWN working graph exported from ComfyUI via 'Save (API Format)', then insert these tokens where shown: __INPUT_IMAGE__ (LoadImage.image), __PROMPT__ (positive CLIPTextEncode.text), __NEGATIVE__ (negative CLIPTextEncode.text), __FRAMES__ (length/num_frames), __WIDTH__, __HEIGHT__, __SEED__ (KSampler.seed). Node ids and class_types below are illustrative and must match YOUR installed Wan/CogVideoX/LTX nodes. Point COMFYUI_WORKFLOW_PATH at your file.",
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "__INPUT_IMAGE__", "upload": "image" }
  },
  "11": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__PROMPT__", "clip": ["30", 0] }
  },
  "12": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__NEGATIVE__", "clip": ["30", 0] }
  },
  "20": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "image": ["10", 0],
      "positive": ["11", 0],
      "negative": ["12", 0],
      "width": "__WIDTH__",
      "height": "__HEIGHT__",
      "length": "__FRAMES__"
    }
  },
  "21": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "__SEED__",
      "steps": 20,
      "cfg": 6.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["31", 0],
      "positive": ["11", 0],
      "negative": ["12", 0],
      "latent_image": ["20", 0]
    }
  },
  "22": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["21", 0], "vae": ["32", 0] }
  },
  "40": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["22", 0],
      "frame_rate": 16,
      "format": "video/h264-mp4",
      "filename_prefix": "autougc_broll"
    }
  },
  "30": { "class_type": "CLIPLoader", "inputs": { "clip_name": "wan_text_encoder.safetensors" } },
  "31": { "class_type": "UNETLoader", "inputs": { "unet_name": "wan2.2_i2v.gguf" } },
  "32": { "class_type": "VAELoader", "inputs": { "vae_name": "wan_vae.safetensors" } }
}
