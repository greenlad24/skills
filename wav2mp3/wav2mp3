#!/bin/bash
#
# wav2mp3 — convert WAV audio to MP3 on macOS (Apple Silicon / M4)
#
# Wraps ffmpeg + libmp3lame with sane defaults, parallel encoding across all
# CPU cores, and automatic handling of the WAV formats libmp3lame cannot take
# directly (high sample rates, multichannel).
#
# Requires: ffmpeg (brew install ffmpeg)

set -u

VERSION="1.0.0"
PROG="${0##*/}"

# ---------------------------------------------------------------- defaults --

OUT_DIR=""            # empty => write beside each source file
QUALITY="standard"    # preset name or an explicit CBR bitrate like 320k
JOBS=""               # empty => detect core count
FORCE=0               # overwrite existing .mp3
DRY_RUN=0
RECURSIVE=1           # directories are walked recursively by default
VERBOSE=0
KEEP_STRUCTURE=1      # mirror sub-directory layout under --output
NO_COLOR=0

# Sample rates libmp3lame accepts. Anything else gets resampled.
LAME_RATES="8000 11025 12000 16000 22050 24000 32000 44100 48000"

# ------------------------------------------------------------------- usage --

usage() {
	cat <<EOF
$PROG $VERSION — convert WAV files to MP3

USAGE
  $PROG [options] <file-or-directory>...

OPTIONS
  -o, --output DIR     Write MP3s to DIR (default: next to each source file)
  -q, --quality Q      Encoding quality (default: standard)
                         high      VBR ~245 kbps, transparent (lame -V0)
                         standard  VBR ~190 kbps, great for music (lame -V2)
                         small     VBR ~130 kbps, podcasts/voice (lame -V5)
                         320k, 256k, 192k, 128k, ...  constant bitrate
  -j, --jobs N         Parallel encodes (default: one per CPU core)
  -f, --force          Overwrite existing MP3s (default: skip them)
  -n, --dry-run        Print what would happen, convert nothing
  -R, --no-recursive   Only look at files directly inside a given directory
  -F, --flatten        Put every MP3 straight in --output, no sub-directories
      --no-color       Disable coloured output
  -v, --verbose        Show the full ffmpeg command and its output
  -h, --help           Show this help
      --version        Show version

EXAMPLES
  $PROG track.wav                          # -> track.mp3 beside the original
  $PROG -q high ~/Music/Session            # whole folder at V0, in place
  $PROG -o ~/Desktop/mp3 -q 320k *.wav     # CBR 320k into one folder
  $PROG -j 4 -n ~/Recordings               # dry run, 4 at a time

NOTES
  * Existing MP3s are skipped unless --force is given. Source WAVs are never
    modified or deleted.
  * WAVs above 48 kHz are resampled (MP3 cannot store them); more than two
    channels are downmixed to stereo. Both are reported as they happen.
  * Tags in the source file are carried over as ID3v2.3, which is what the
    Music app and most car stereos expect.
EOF
}

# -------------------------------------------------------------- utilities --

# Defined empty up front so errors raised during argument parsing — before
# setup_colors knows whether --no-color was passed — still print.
C_RESET="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW="" C_BOLD=""

setup_colors() {
	if [ "$NO_COLOR" -eq 1 ] || [ ! -t 1 ]; then
		C_RESET="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW="" C_BOLD=""
	else
		C_RESET=$'\033[0m'  C_DIM=$'\033[2m'    C_RED=$'\033[31m'
		C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m' C_BOLD=$'\033[1m'
	fi
}

info()  { printf '%s\n' "$*"; }
warn()  { printf '%s%s%s\n' "$C_YELLOW" "$*" "$C_RESET" >&2; }
err()   { printf '%s%s%s\n' "$C_RED" "$*" "$C_RESET" >&2; }
debug() { [ "$VERBOSE" -eq 1 ] && printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET" >&2; return 0; }

die() { err "$PROG: $*"; exit 1; }

# Byte size of a file, BSD (macOS) first then GNU.
file_size() {
	stat -f%z "$1" 2>/dev/null || stat -c%s "$1" 2>/dev/null || echo 0
}

human_size() {
	awk -v b="$1" 'BEGIN{
		split("B KB MB GB TB", u, " "); i = 1
		while (b >= 1024 && i < 5) { b /= 1024; i++ }
		printf (i == 1 ? "%d %s" : "%.1f %s"), b, u[i]
	}'
}

# Logical core count: macOS, then Linux, then a safe fallback.
detect_jobs() {
	local n
	n=$(sysctl -n hw.logicalcpu 2>/dev/null) \
		|| n=$(getconf _NPROCESSORS_ONLN 2>/dev/null) \
		|| n=""
	case "$n" in
		''|*[!0-9]*) echo 4 ;;
		*) echo "$n" ;;
	esac
}

# Turn a quality option into ffmpeg encoder arguments.
# Sets QUALITY_ARGS and QUALITY_LABEL.
resolve_quality() {
	case "$1" in
		high)     QUALITY_ARGS="-q:a 0"; QUALITY_LABEL="VBR V0 (~245 kbps)" ;;
		standard) QUALITY_ARGS="-q:a 2"; QUALITY_LABEL="VBR V2 (~190 kbps)" ;;
		small)    QUALITY_ARGS="-q:a 5"; QUALITY_LABEL="VBR V5 (~130 kbps)" ;;
		[0-9]*[kK])
			local kbps="${1%[kK]}"
			case "$kbps" in
				''|*[!0-9]*) die "invalid bitrate: $1" ;;
			esac
			[ "$kbps" -ge 8 ] && [ "$kbps" -le 320 ] \
				|| die "bitrate out of range (8k-320k): $1"
			QUALITY_ARGS="-b:a ${kbps}k"; QUALITY_LABEL="CBR ${kbps} kbps"
			;;
		*) die "unknown quality '$1' (try: high, standard, small, or 320k)" ;;
	esac
}

# ------------------------------------------------------------- conversion --

# Pick a sample rate libmp3lame will accept, nearest at or below the source.
target_rate() {
	local src="$1" best="" r
	case "$src" in
		''|*[!0-9]*) echo 44100; return ;;
	esac
	for r in $LAME_RATES; do
		[ "$r" = "$src" ] && { echo "$src"; return; }
	done
	for r in $LAME_RATES; do
		[ "$r" -lt "$src" ] && best="$r"
	done
	[ -n "$best" ] && echo "$best" || echo 8000
}

# convert <src> <dst> <status-file>
# Writes "ok|skip|fail <bytes-in> <bytes-out>" to the status file.
convert_one() {
	local src="$1" dst="$2" status="$3"
	local rate channels rate_arg="" chan_arg="" notes=""

	# ffprobe tells us whether the stream needs reshaping before lame sees it.
	local probe
	probe=$(ffprobe -v error -select_streams a:0 \
		-show_entries stream=sample_rate,channels \
		-of default=noprint_wrappers=1:nokey=1 "$src" 2>/dev/null)
	rate=$(printf '%s\n' "$probe" | sed -n 1p)
	channels=$(printf '%s\n' "$probe" | sed -n 2p)

	if [ -z "$rate" ]; then
		err "  ✗ ${src##*/}: no readable audio stream"
		printf 'fail 0 0\n' >"$status"
		return 1
	fi

	local want
	want=$(target_rate "$rate")
	if [ "$want" != "$rate" ]; then
		rate_arg="-ar $want"
		notes="${notes}${notes:+, }${rate} Hz → ${want} Hz"
	fi

	case "$channels" in
		''|*[!0-9]*) : ;;
		*) if [ "$channels" -gt 2 ]; then
			chan_arg="-ac 2"
			notes="${notes}${notes:+, }${channels}ch → stereo"
		fi ;;
	esac

	mkdir -p "${dst%/*}" 2>/dev/null

	# Encode to a temp file so an interrupted run never leaves a partial MP3.
	local tmp="${dst}.part.$$"
	debug "ffmpeg -i $src -codec:a libmp3lame $QUALITY_ARGS $rate_arg $chan_arg $tmp"

	local ff_log ff_status
	ff_log=$(ffmpeg -hide_banner -nostdin -y -i "$src" \
		-vn -codec:a libmp3lame $QUALITY_ARGS $rate_arg $chan_arg \
		-map_metadata 0 -id3v2_version 3 -write_id3v1 1 \
		-f mp3 "$tmp" 2>&1)
	ff_status=$?

	if [ "$ff_status" -ne 0 ] || [ ! -s "$tmp" ]; then
		rm -f "$tmp"
		err "  ✗ ${src##*/}"
		printf '%s\n' "$ff_log" | tail -3 >&2
		printf 'fail 0 0\n' >"$status"
		return 1
	fi

	[ "$VERBOSE" -eq 1 ] && printf '%s\n' "$ff_log" >&2

	mv -f "$tmp" "$dst" || {
		rm -f "$tmp"
		err "  ✗ ${src##*/}: could not write ${dst}"
		printf 'fail 0 0\n' >"$status"
		return 1
	}

	local in_bytes out_bytes
	in_bytes=$(file_size "$src")
	out_bytes=$(file_size "$dst")

	printf '  %s✓%s %s %s(%s → %s%s)%s\n' \
		"$C_GREEN" "$C_RESET" "${src##*/}" "$C_DIM" \
		"$(human_size "$in_bytes")" "$(human_size "$out_bytes")" \
		"${notes:+; $notes}" "$C_RESET"

	printf 'ok %s %s\n' "$in_bytes" "$out_bytes" >"$status"
	return 0
}

# Block until fewer than $JOBS background encodes are running.
throttle() {
	while [ "$(jobs -pr | wc -l | tr -d ' ')" -ge "$JOBS" ]; do
		sleep 0.1
	done
}

# --------------------------------------------------------- argument parsing --

INPUTS=()

while [ $# -gt 0 ]; do
	case "$1" in
		-o|--output)   [ $# -ge 2 ] || die "$1 needs a directory"; OUT_DIR="$2"; shift 2 ;;
		-q|--quality)  [ $# -ge 2 ] || die "$1 needs a value"; QUALITY="$2"; shift 2 ;;
		-j|--jobs)     [ $# -ge 2 ] || die "$1 needs a number"; JOBS="$2"; shift 2 ;;
		-f|--force)    FORCE=1; shift ;;
		-n|--dry-run)  DRY_RUN=1; shift ;;
		-R|--no-recursive) RECURSIVE=0; shift ;;
		-F|--flatten)  KEEP_STRUCTURE=0; shift ;;
		--no-color)    NO_COLOR=1; shift ;;
		-v|--verbose)  VERBOSE=1; shift ;;
		-h|--help)     usage; exit 0 ;;
		--version)     echo "$PROG $VERSION"; exit 0 ;;
		--)            shift; while [ $# -gt 0 ]; do INPUTS+=("$1"); shift; done ;;
		-*)            die "unknown option '$1' (see --help)" ;;
		*)             INPUTS+=("$1"); shift ;;
	esac
done

setup_colors

[ ${#INPUTS[@]} -gt 0 ] || { usage >&2; exit 2; }

command -v ffmpeg >/dev/null 2>&1 || die "ffmpeg not found. Install it with:  brew install ffmpeg"
command -v ffprobe >/dev/null 2>&1 || die "ffprobe not found. Install it with:  brew install ffmpeg"

ffmpeg -hide_banner -encoders 2>/dev/null | grep -q ' libmp3lame ' \
	|| die "this ffmpeg has no libmp3lame encoder. Reinstall with:  brew reinstall ffmpeg"

resolve_quality "$QUALITY"

[ -n "$JOBS" ] || JOBS=$(detect_jobs)
case "$JOBS" in
	''|*[!0-9]*|0) die "invalid --jobs value: $JOBS" ;;
esac

if [ -n "$OUT_DIR" ]; then
	mkdir -p "$OUT_DIR" || die "cannot create output directory: $OUT_DIR"
	# Normalise to an absolute path so per-file output paths stay correct.
	OUT_DIR=$(cd "$OUT_DIR" && pwd)
fi

# --------------------------------------------------------- collect the work --

# Parallel arrays: SRCS[i] converts to DSTS[i]. Kept in step at all times.
SRCS=()
DSTS=()

# Destination for a source file, honouring --output / --flatten and the
# directory root it was discovered under.
dest_for() {
	local src="$1" root="$2" base rel
	base="${src##*/}"
	base="${base%.*}.mp3"

	if [ -z "$OUT_DIR" ]; then
		printf '%s\n' "${src%/*}/$base"
		return
	fi
	if [ "$KEEP_STRUCTURE" -eq 0 ] || [ -z "$root" ]; then
		printf '%s\n' "$OUT_DIR/$base"
		return
	fi

	rel="${src#$root/}"           # path relative to the directory the user gave
	rel="${rel%/*}"               # its sub-directory, if any
	if [ "$rel" = "${src#$root/}" ]; then
		printf '%s\n' "$OUT_DIR/$base"   # file sat directly in root
	else
		printf '%s\n' "$OUT_DIR/$rel/$base"
	fi
}

# add_file <src> <root> <from-walk>
# Files discovered by a directory walk are already extension-filtered by find;
# only explicitly named files get checked (and warned about) here.
add_file() {
	local src="$1" root="$2" from_walk="$3" ext
	if [ "$from_walk" -eq 0 ]; then
		ext=$(printf '%s' "${src##*.}" | tr '[:upper:]' '[:lower:]')
		case "$ext" in
			wav|wave) ;;
			*) warn "skipping (not a WAV): $src"; return 0 ;;
		esac
	fi
	SRCS[${#SRCS[@]}]="$src"
	DSTS[${#DSTS[@]}]="$(dest_for "$src" "$root")"
}

# NUL-safe sort is not available everywhere; fall back to find's own order.
if printf 'a\000' | sort -z >/dev/null 2>&1; then SORT_Z=1; else SORT_Z=0; fi
sort_nul() { if [ "$SORT_Z" -eq 1 ]; then LC_ALL=C sort -z; else cat; fi; }

# Kept as a function so neither branch needs an array that may be empty —
# bash 3.2 (the macOS system bash) errors on "${empty[@]}" under `set -u`.
walk() {
	if [ "$RECURSIVE" -eq 1 ]; then
		find "$1" -type f \( -iname '*.wav' -o -iname '*.wave' \) -print0 2>/dev/null
	else
		find "$1" -maxdepth 1 -type f \( -iname '*.wav' -o -iname '*.wave' \) -print0 2>/dev/null
	fi | sort_nul
}

for input in "${INPUTS[@]}"; do
	if [ -d "$input" ]; then
		root="${input%/}"
		[ -n "$root" ] || root="/"
		root=$(cd "$root" && pwd) || { err "cannot enter: $input"; continue; }
		while IFS= read -r -d '' f; do
			add_file "$f" "$root" 1
		done < <(walk "$root")
	elif [ -f "$input" ]; then
		add_file "$input" "" 0
	else
		err "no such file or directory: $input"
	fi
done

TOTAL=${#SRCS[@]}
[ "$TOTAL" -gt 0 ] || die "no WAV files found"

# ----------------------------------------------------------------- run it --

printf '%s%d WAV file(s)%s · %s · %d parallel job(s)\n' \
	"$C_BOLD" "$TOTAL" "$C_RESET" "$QUALITY_LABEL" "$JOBS"
[ -n "$OUT_DIR" ] && info "output: $OUT_DIR"

STATUS_DIR=$(mktemp -d "${TMPDIR:-/tmp}/wav2mp3.XXXXXX") || die "cannot create temp dir"
cleanup() {
	# Kill outstanding encoders, then drop partial files and bookkeeping.
	local pids
	pids=$(jobs -pr 2>/dev/null)
	[ -n "$pids" ] && kill $pids 2>/dev/null
	rm -rf "$STATUS_DIR"
}
trap 'cleanup; exit 130' INT TERM
trap 'rm -rf "$STATUS_DIR"' EXIT

skipped=0
i=0
while [ "$i" -lt "$TOTAL" ]; do
	src="${SRCS[$i]}"
	dst="${DSTS[$i]}"
	i=$((i + 1))

	if [ -e "$dst" ] && [ "$FORCE" -eq 0 ]; then
		info "  ${C_DIM}– ${src##*/} (MP3 exists, use --force)${C_RESET}"
		skipped=$((skipped + 1))
		continue
	fi

	if [ "$DRY_RUN" -eq 1 ]; then
		info "  ${C_DIM}would write${C_RESET} $dst"
		continue
	fi

	throttle
	convert_one "$src" "$dst" "$STATUS_DIR/$i" &
done

wait

if [ "$DRY_RUN" -eq 1 ]; then
	info "${C_BOLD}Dry run:${C_RESET} $((TOTAL - skipped)) file(s) would be converted, $skipped skipped."
	exit 0
fi

# ------------------------------------------------------------------ tally --

ok=0; failed=0; bytes_in=0; bytes_out=0
for f in "$STATUS_DIR"/*; do
	[ -e "$f" ] || continue
	read -r state in_b out_b <"$f" || continue
	case "$state" in
		ok)   ok=$((ok + 1))
		      bytes_in=$((bytes_in + in_b))
		      bytes_out=$((bytes_out + out_b)) ;;
		fail) failed=$((failed + 1)) ;;
	esac
done

summary="${C_BOLD}Done:${C_RESET} $ok converted"
[ "$skipped" -gt 0 ] && summary="$summary, $skipped skipped"
[ "$failed" -gt 0 ] && summary="$summary, ${C_RED}$failed failed${C_RESET}"
info "$summary"

if [ "$ok" -gt 0 ] && [ "$bytes_in" -gt 0 ]; then
	pct=$(awk -v i="$bytes_in" -v o="$bytes_out" 'BEGIN{printf "%.0f", (1 - o/i) * 100}')
	info "${C_DIM}$(human_size "$bytes_in") → $(human_size "$bytes_out")  (${pct}% smaller)${C_RESET}"
fi

[ "$failed" -eq 0 ] || exit 1
exit 0
