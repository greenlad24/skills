# Backend base URLs. Leave empty to use same-origin (Vite dev proxy forwards /api and /ws
# to localhost:8000; the nginx production image proxies the same paths to the api service).
#
# Set these only if the API lives on a different host/port than the one serving the SPA.
VITE_API_BASE=
VITE_WS_BASE=

# Optional single local password. When APP_PASSWORD is set on the backend, put the same
# value here so the client sends the X-App-Password header on every request.
VITE_APP_PASSWORD=

# Dev-only: where the Vite proxy forwards to (used by vite.config.ts, not the app).
VITE_API_TARGET=http://localhost:8000
VITE_WS_TARGET=ws://localhost:8000
